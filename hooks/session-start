#!/usr/bin/env bash
# SessionStart hook for Ambrosia skill suite

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-ambrosia skill content
using_ambrosia_content=$(cat "${PLUGIN_ROOT}/skills/using-ambrosia/SKILL.md" 2>&1 || echo "Error reading using-ambrosia skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_ambrosia_escaped=$(escape_for_json "$using_ambrosia_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have Ambrosia active.\n\n**Below is the full content of your 'ambrosia:using-ambrosia' skill - your introduction to using skills and standing behavioral orders:**\n\n${using_ambrosia_escaped}\n</EXTREMELY_IMPORTANT>"

# Multi-harness hook format dispatch:
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor Agent format (snake_case)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
else
  # Antigravity CLI / Claude Code / Generic SDK format
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  },\n  "additionalContext": "%s"\n}\n' "$session_context" "$session_context" | cat
fi

exit 0
